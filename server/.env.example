# AURA LIVE VOICE CHAT — PRODUCTION ENVIRONMENT CONFIGURATION (TEMPLATE)

# ================================================================
# 1. DATABASE CONFIGURATION (POSTGRESQL 16+)
# ================================================================
DATABASE_URL="postgresql://auralive_admin:SecurePassword123!@postgres.auralive.internal:5432/auralive_prod_db?schema=public&connection_limit=50&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://auralive_admin:SecurePassword123!@postgres.auralive.internal:5432/auralive_prod_db?schema=public"

# ================================================================
# 2. SERVER PORT & JWT SECURITY
# ================================================================
PORT=3001
NODE_ENV=production
JWT_SECRET="aura_live_prod_jwt_super_secret_key_99"
JWT_REFRESH_SECRET="aura_live_prod_jwt_refresh_secret_key_99"
SESSION_SECRET="aura_live_prod_session_secret_99"

# ================================================================
# 3. AGORA RTC & MEDIA ENGINE
# ================================================================
AGORA_APP_ID="YOUR_PRODUCTION_AGORA_APP_ID"
AGORA_APP_CERTIFICATE="YOUR_PRODUCTION_AGORA_APP_CERTIFICATE"

# ================================================================
# 4. FIREBASE CLOUD MESSAGING (FCM) & PUSH NOTIFICATIONS
# ================================================================
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"aura-live-voice-chat-app","private_key_id":"YOUR_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\\nYOUR_KEY\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@aura-live-voice-chat-app.iam.gserviceaccount.com"}'

# ================================================================
# 5. GOOGLE OAUTH AUTHENTICATION
# ================================================================
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ================================================================
# 6. AWS S3 / CLOUDFLARE R2 MEDIA STORAGE
# ================================================================
S3_BUCKET_NAME="auralive-media-prod"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION="us-east-1"
S3_CUSTOM_DOMAIN="https://cdn.auralive.app"

# ================================================================
# 7. REDIS CACHE & REALTIME PUB/SUB
# ================================================================
REDIS_URL="redis://default:SecureRedisPassword123!@redis.auralive.internal:6379"
