# ============================================================
# AURA LIVE — PRODUCTION ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── DATABASE ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/auralive?schema=public"

# ── JWT SECRETS ──
JWT_ACCESS_SECRET="CHANGE_ME_random_64_char_string_for_access_tokens"
JWT_REFRESH_SECRET="CHANGE_ME_random_64_char_string_for_refresh_tokens"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── SERVER ──
PORT=3001
NODE_ENV="development"
CORS_ORIGINS="http://localhost:8443,http://localhost:5173"

# ── AGORA RTC ──
AGORA_APP_ID="YOUR_AGORA_APP_ID"
AGORA_APP_CERTIFICATE="YOUR_AGORA_APP_CERTIFICATE"

# ── GOOGLE CLOUD STORAGE ──
GCS_PROJECT_ID="YOUR_GCS_PROJECT_ID"
GCS_BUCKET_NAME="auralive-media"
GCS_KEY_FILE="./gcs-service-account.json"

# ── PAYMENT (FUTURE) ──
# STRIPE_SECRET_KEY=""
# JAZZCASH_MERCHANT_ID=""
# EASYPAISA_MERCHANT_ID=""

# ── GOOGLE OAUTH ──
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# ── ADMIN ──
ADMIN_INITIAL_EMAIL="admin@auralive.io"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_admin_password"
