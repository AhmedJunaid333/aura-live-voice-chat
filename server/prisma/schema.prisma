datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int               @id @default(autoincrement())
  numericId       Int               @unique
  username        String            @unique
  displayName     String?
  email           String?           @unique
  phone           String?           @unique
  passwordHash    String
  avatar          String?
  cover           String?
  bio             String?           @default("Aura Live Registered User ✨")
  gender          String?           @default("Prefer not to say")
  birthday        DateTime?
  country         String?           @default("Pakistan")
  countryCode     String?           @default("PK")
  level           Int               @default(1)
  xp              Int               @default(0)
  vipTier         Int               @default(0)
  coins           Int               @default(0)
  diamonds        Int               @default(0)
  role            String            @default("USER")
  status          String            @default("ACTIVE")
  walletFrozen    Boolean           @default(false)
  cnicNumber      String?
  cnicFrontUrl    String?
  selfieUrl       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  sessions              Session[]
  walletTransactions    WalletTransaction[]
  resellerAccount       ResellerAccount?
  sentInvitations       ResellerInvitation[]    @relation("InviterAdmin")
  receivedInvitations   ResellerInvitation[]    @relation("TargetUser")
  applications          ResellerApplication[]   @relation("ApplicantUser")
  reviewedApplications  ResellerApplication[]   @relation("ReviewerAdmin")
  hostedRooms           LiveRoom[]              @relation("HostUser")
  sentMessages          Message[]               @relation("MessageSender")
  conversationMembers   ConversationMember[]
  sentGifts             GiftTransaction[]       @relation("GiftSender")
  receivedGifts         GiftTransaction[]       @relation("GiftReceiver")
  medals                UserMedal[]
  familyMembership      FamilyMember?
  blockedUsers          BlockedUser[]           @relation("UserBlocker")
  blockedBy             BlockedUser[]           @relation("UserBlocked")
  auditLogs             AuditLog[]              @relation("ActorUser")
  authAccounts          AuthAccount[]
  coinSellerAccount     CoinSellerAccount?
  withdrawalRequests    WithdrawalRequest[]     @relation("UserWithdrawals")
  following             Follow[]                @relation("UserFollowers")
  followers             Follow[]                @relation("UserFollowing")
  activeViewers         LiveRoomViewer[]
  visitsMade            ProfileVisit[]          @relation("UserVisitsMade")
  visitsReceived        ProfileVisit[]          @relation("UserVisitsReceived")
  notifications         Notification[]          @relation("NotificationRecipient")
  sentNotifications     Notification[]          @relation("NotificationSender")
  reportsFiled          MessageReport[]         @relation("ReportedBy")
  reportsReceived       MessageReport[]         @relation("ReportedTarget")
  roomJoinRequests      RoomJoinRequest[]       @relation("UserJoinRequests")
  ledFamilies           Family[]                @relation("FamilyLeader")
  sentFamilyInvitations FamilyInvitation[]      @relation("SentFamilyInvitations")
  receivedFamilyInvitations FamilyInvitation[]  @relation("ReceivedFamilyInvitations")
  familyBans            FamilyBan[]             @relation("FamilyBannedUser")
  executedFamilyBans    FamilyBan[]             @relation("FamilyBanActor")
  familyMessages        FamilyMessage[]         @relation("FamilyMessages")
  familyAnnouncements   FamilyAnnouncement[]    @relation("FamilyAnnouncements")
  familyContributions   FamilyContribution[]    @relation("UserFamilyContributions")
  mutedUsers            MutedUser[]             @relation("UserMuter")
  mutedBy               MutedUser[]             @relation("UserMuted")
  userReportsFiled      UserReport[]            @relation("UserReportedBy")
  userReportsReceived   UserReport[]            @relation("UserReportedTarget")
  restrictions          AccountRestriction[]    @relation("UserRestrictions")
  createdRestrictions   AccountRestriction[]    @relation("AdminCreatedRestrictions")
  roomAdminRoles        LiveRoomAdmin[]         @relation("UserRoomAdmin")
  createdRoomAdmins     LiveRoomAdmin[]         @relation("AdminCreatedRoomAdmins")
  occupiedSeats         LiveRoomSeat[]          @relation("UserOccupiedSeats")
  moments               Moment[]                @relation("UserMoments")
  momentLikes           MomentLike[]            @relation("UserMomentLikes")
  momentComments        MomentComment[]         @relation("UserMomentComments")
  momentShares          MomentShare[]           @relation("UserMomentShares")
  momentReports         MomentReport[]          @relation("UserMomentReports")
  equippedFrameId       String?
  frameOwnerships       AvatarFrameOwnership[]  @relation("UserFrameOwnerships")
  framePurchases        AvatarFramePurchase[]   @relation("UserFramePurchases")
  membershipProfile     MembershipProfile?
  membershipXpTransactions MembershipXpTransaction[]
  membershipHistories   MembershipHistory[]
  membershipRewardClaims MembershipRewardClaim[]
  broadcastHistories    BroadcastHistory[]      @relation("UserBroadcastHistories")
  profileApplications   Application[]           @relation("UserProfileApplications")

  @@index([numericId])
  @@index([username])
}

model AuthAccount {
  id                String   @id @default(uuid())
  userId            Int
  provider          String   @default("GOOGLE")
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id            String    @id @default(uuid())
  userId        Int
  token         String    @unique
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id            String        @id @default(uuid())
  userId        Int
  type          String
  currency      String
  amount        Int
  balanceAfter  Int           @default(0)
  referenceId   String?
  notes         String?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResellerAccount {
  id                String            @id @default(uuid())
  userId            Int               @unique
  resellerCode      String?           @unique
  displayName       String?
  role              String            @default("DIAMOND_RESELLER")
  status            String            @default("ACTIVE")
  diamondBalance    Int               @default(500000)
  diamondsReceived  Int               @default(500000)
  diamondsSent      Int               @default(0)
  whatsappNumber    String?           @default("+923001234567")
  phone             String?           @default("+923001234567")
  minPurchase       Int               @default(10000)
  startingRate      String?           @default("10,000 Diamonds = Rs. 1,500")
  paymentMethods    String?           @default("Easypaisa, JazzCash, Bank Transfer")
  packages          String?           @default("[{\"diamonds\":10000,\"price\":\"Rs. 1,500\",\"priceUsd\":5.0},{\"diamonds\":50000,\"price\":\"Rs. 7,250\",\"priceUsd\":25.0},{\"diamonds\":100000,\"price\":\"Rs. 14,000\",\"priceUsd\":50.0},{\"diamonds\":500000,\"price\":\"Rs. 68,000\",\"priceUsd\":240.0}]")
  operatingInfo     String?           @default("Instant delivery within 2-5 minutes via authorized Reseller Portal. Official KYC verified.")
  isVerified        Boolean           @default(true)
  displayOrder      Int               @default(0)
  assignedAt        DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model ResellerInvitation {
  id                String            @id @default(uuid())
  code              String            @unique
  type              String            @default("RESELLER")
  targetUserId      Int
  invitedByAdminId  Int
  message           String?
  requirements      String?
  benefits          String?
  expiryDays        Int               @default(7)
  expiresAt         DateTime
  status            String            @default("PENDING")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  targetUser        User              @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  invitedByAdmin    User              @relation("InviterAdmin", fields: [invitedByAdminId], references: [id], onDelete: Cascade)
  application       ResellerApplication?
}

model ResellerApplication {
  id                String              @id @default(uuid())
  invitationId      String?             @unique
  userId            Int
  type              String              @default("RESELLER")
  applicantName     String
  email             String?
  phone             String?
  country           String?
  city              String?
  formData          String?
  documents         String?
  status            String              @default("SUBMITTED")
  reviewerAdminId   Int?
  notes             String?
  submittedAt       DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User                @relation("ApplicantUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewerAdmin     User?               @relation("ReviewerAdmin", fields: [reviewerAdminId], references: [id], onDelete: SetNull)
  invitation        ResellerInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
}

model ResellerLedger {
  id            String        @id @default(uuid())
  senderId      String
  senderRole    String
  receiverId    String
  receiverRole  String
  amount        Int
  currency      String        @default("DIAMOND")
  type          String
  status        String        @default("COMPLETED")
  referenceId   String?
  createdAt     DateTime      @default(now())
}


model Conversation {
  id            String                @id @default(uuid())
  isGroup       Boolean               @default(false)
  title         String?
  lastMessageAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  members       ConversationMember[]
  messages      Message[]
}

model ConversationMember {
  id              String        @id @default(uuid())
  conversationId  String
  userId          Int
  joinedAt        DateTime      @default(now())
  lastReadAt      DateTime      @default(now())

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id              String        @id @default(uuid())
  conversationId  String
  senderId        Int
  type            String        @default("TEXT")
  content         String
  mediaUrl        String?
  metadata        String?
  isRead          Boolean       @default(false)
  readAt          DateTime?
  isDeleted       Boolean       @default(false)
  replyToId       String?
  createdAt       DateTime      @default(now())

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reports         MessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model LiveRoom {
  id                String            @id @default(uuid())
  roomId            String            @unique
  title             String
  description       String?
  announcement      String?
  cover             String?
  tags              String?
  language          String            @default("English")
  rules             String?
  category          String            @default("Music")
  countryCode       String            @default("PK")
  hostId            Int
  seatCount         Int               @default(10)
  seatLayoutType    String            @default("2_ROWS") // 1_ROW, 2_ROWS, CIRCULAR, GRID, PREMIUM
  status            String            @default("LIVE") // LIVE, LOCKED, ENDED
  isLocked          Boolean           @default(false)
  lockedAt          DateTime?
  lockedBy          Int?
  lockMode          String?           @default("MANUAL_LOCK") // MANUAL_LOCK, PASSWORD_LOCK
  lockPassword      String?
  allowsJoinRequest Boolean           @default(true)
  listenersCount    Int               @default(0)
  viewerCount       Int               @default(0)
  rankingScore      Float             @default(0)
  likesCount        Int               @default(0)
  isPK              Boolean           @default(false)
  theme             String            @default("galaxy")
  familyId          String?
  isFamilyOnly      Boolean           @default(false)
  slowMode          Boolean           @default(false)
  slowModeSeconds   Int               @default(3)
  chatMuted         Boolean           @default(false)
  muteAllMics       Boolean           @default(false)
  peakViewers       Int               @default(0)
  totalViewers      Int               @default(0)
  newFollowers      Int               @default(0)
  totalGifts        Int               @default(0)
  totalDiamonds     Int               @default(0)
  totalComments     Int               @default(0)
  guestsJoined      Int               @default(0)
  seatsUsed         Int               @default(0)
  durationSeconds   Int               @default(0)
  endedBy           String?           @default("HOST") // HOST, ADMIN, SYSTEM
  endReason         String?
  endedAt           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  host              User              @relation("HostUser", fields: [hostId], references: [id], onDelete: Cascade)
  family            Family?           @relation(fields: [familyId], references: [id], onDelete: SetNull)
  giftTxns          GiftTransaction[]
  joinRequests      RoomJoinRequest[]
  roomAdmins        LiveRoomAdmin[]
  seats             LiveRoomSeat[]
  viewers           LiveRoomViewer[]
}

model BroadcastHistory {
  id                String    @id @default(uuid())
  broadcastId       String    @unique
  roomId            String
  hostId            Int
  title             String
  category          String    @default("Music")
  seatCapacity      Int       @default(10)
  startedAt         DateTime  @default(now())
  endedAt           DateTime  @default(now())
  durationSeconds   Int       @default(0)
  formattedDuration String    @default("00:00:00")
  peakViewers       Int       @default(0)
  totalViewers      Int       @default(0)
  uniqueViewers     Int       @default(0)
  newFollowers      Int       @default(0)
  totalGifts        Int       @default(0)
  diamondsEarned    Int       @default(0)
  totalComments     Int       @default(0)
  guestsJoined      Int       @default(0)
  seatsUsed         Int       @default(0)
  seatOccupancyRate Float     @default(0)
  endedBy           String    @default("HOST") // HOST, ADMIN, SYSTEM
  endReason         String?
  status            String    @default("ENDED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  host              User      @relation("UserBroadcastHistories", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
  @@index([roomId])
  @@index([startedAt])
}

model LiveRoomViewer {
  id          String    @id @default(uuid())
  roomId      String
  userId      Int
  socketId    String?
  countryCode String?   @default("PK")
  joinedAt    DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  room        LiveRoom  @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model LiveRoomSeat {
  id          String    @id @default(uuid())
  roomId      String
  seatNumber  Int       // 1 to 20
  userId      Int?
  status      String    @default("EMPTY") // "EMPTY" | "OCCUPIED" | "LOCKED" | "MUTED" | "SPEAKING"
  isMuted     Boolean   @default(false)
  isLocked    Boolean   @default(false)
  isHost      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room        LiveRoom  @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  user        User?     @relation("UserOccupiedSeats", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([roomId, seatNumber])
  @@index([roomId])
  @@index([userId])
}

model LiveRoomAdmin {
  id          String    @id @default(uuid())
  roomId      String
  userId      Int
  role        String    @default("ROOM_ADMIN") // "ROOM_ADMIN" | "ROOM_MODERATOR"
  permissions String    @default("manage_room,manage_seats,mute_users,kick_users,ban_users,manage_chat,edit_info")
  createdBy   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room        LiveRoom  @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  user        User      @relation("UserRoomAdmin", fields: [userId], references: [id], onDelete: Cascade)
  adminActor  User      @relation("AdminCreatedRoomAdmins", fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model RoomJoinRequest {
  id              String          @id @default(uuid())
  roomId          String
  userId          Int
  userName        String
  userAvatar      String?
  status          String          @default("PENDING") // PENDING, ACCEPTED, REJECTED
  reviewedBy      Int?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  room            LiveRoom        @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  user            User            @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([userId])
}

model Gift {
  id              String          @id @default(uuid())
  name            String
  icon            String
  costCoins       Int
  rewardDiamonds  Int
  category        String          @default("Popular")
  animationType   String          @default("SVG") // SVG, SVGA, LOTTIE, 3D_OVERLAY, FULL_SCREEN, SMALL
  svgaUrl         String?
  lottieUrl       String?
  imageUrl        String?
  soundUrl        String?
  xpReward        Int             @default(100)
  isLucky         Boolean         @default(false)
  multiplierMax   Int             @default(500)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())

  transactions    GiftTransaction[]
}

model GiftTransaction {
  id              String        @id @default(uuid())
  roomId          String?
  senderId        Int
  receiverId      Int
  giftId          String
  count           Int           @default(1)
  totalCoins      Int
  totalDiamonds   Int
  createdAt       DateTime      @default(now())

  room            LiveRoom?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sender          User          @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User          @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  gift            Gift          @relation(fields: [giftId], references: [id], onDelete: Cascade)
}

model Family {
  id              String                @id @default(uuid())
  familyId        String                @unique
  name            String                @unique
  icon            String?               @default("🦁")
  logo            String?
  description     String?               @default("Official Aura Live Family")
  rules           String?               @default("1. Respect all members\n2. Support family audio rooms\n3. Follow Aura Live guidelines")
  leaderId        Int
  level           Int                   @default(1)
  xp              Int                   @default(0)
  totalDiamonds   Int                   @default(0)
  weeklyDiamonds  Int                   @default(0)
  monthlyDiamonds Int                   @default(0)
  treasuryCoins   Int                   @default(0)
  status          String                @default("ACTIVE") // ACTIVE, SUSPENDED
  badge           String?               @default("👑 VIP FAMILY")
  country         String                @default("Pakistan")
  notice          String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  leader          User                  @relation("FamilyLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members         FamilyMember[]
  invitations     FamilyInvitation[]
  rooms           LiveRoom[]
  messages        FamilyMessage[]
  announcements   FamilyAnnouncement[]
  contributions   FamilyContribution[]
  bans            FamilyBan[]
}

model FamilyMember {
  id                    String      @id @default(uuid())
  familyId              String
  userId                Int         @unique
  role                  String      @default("MEMBER") // OWNER, ADMIN, CO_ADMIN, HOST, MEMBER
  contributionDiamonds  Int         @default(0)
  contributionCoins     Int         @default(0)
  permissions           String?
  joinedAt              DateTime    @default(now())

  family                Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, role])
}

model FamilyInvitation {
  id            String      @id @default(uuid())
  familyId      String
  inviterId     Int
  targetUserId  Int
  status        String      @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?

  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviter       User        @relation("SentFamilyInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  targetUser    User        @relation("ReceivedFamilyInvitations", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, status])
  @@index([familyId, status])
}

model FamilyBan {
  id          String      @id @default(uuid())
  familyId    String
  userId      Int
  bannedBy    Int
  reason      String?
  createdAt   DateTime    @default(now())

  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User        @relation("FamilyBannedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor       User        @relation("FamilyBanActor", fields: [bannedBy], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

model FamilyMessage {
  id          String      @id @default(uuid())
  familyId    String
  senderId    Int
  type        String      @default("TEXT") // TEXT, IMAGE, GIFT_ALERT, SYS_JOIN, SYS_ROLE
  content     String
  mediaUrl    String?
  replyToId   String?
  createdAt   DateTime    @default(now())

  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sender      User        @relation("FamilyMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

model FamilyAnnouncement {
  id          String      @id @default(uuid())
  familyId    String
  authorId    Int
  title       String
  content     String
  isPinned    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author      User        @relation("FamilyAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([familyId, isPinned])
}

model FamilyContribution {
  id                String      @id @default(uuid())
  familyId          String
  userId            Int
  diamonds          Int         @default(0)
  coins             Int         @default(0)
  giftTransactionId String?
  createdAt         DateTime    @default(now())

  family            Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user              User        @relation("UserFamilyContributions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
  @@index([userId])
}

model Medal {
  id                String      @id @default(uuid())
  name              String
  category          String
  icon              String
  rarity            String      @default("RARE")
  xpBonus           String?
  unlockCondition   String?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())

  userMedals        UserMedal[]
}

model UserMedal {
  id            String    @id @default(uuid())
  userId        Int
  medalId       String
  awardedAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal         Medal     @relation(fields: [medalId], references: [id], onDelete: Cascade)

  @@unique([userId, medalId])
}

model BlockedUser {
  id            String    @id @default(uuid())
  blockerId     Int
  blockedId     Int
  reason        String?
  createdAt     DateTime  @default(now())

  blocker       User      @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked       User      @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model AccountRestriction {
  id            String    @id @default(uuid())
  userId        Int
  type          String    // "SUSPENDED" | "BLOCKED" | "BANNED"
  reason        String
  createdBy     Int?
  expiresAt     DateTime?
  status        String    @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "REVOKED"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation("UserRestrictions", fields: [userId], references: [id], onDelete: Cascade)
  admin         User?     @relation("AdminCreatedRestrictions", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model AuditLog {
  id            String    @id @default(uuid())
  actorId       Int?
  actorRole     String
  action        String
  resource      String
  details       String?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  actor         User?     @relation("ActorUser", fields: [actorId], references: [id], onDelete: SetNull)
}

model CoinSellerAccount {
  id                String              @id @default(uuid())
  userId            Int                 @unique
  sellerName        String
  status            String              @default("ACTIVE")
  paymentMethods    String              @default("Easypaisa,JazzCash,Bank Transfer,USDT")
  totalProcessed    Int                 @default(0)
  assignedAt        DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[] @relation("SellerWithdrawals")
}

model WithdrawalRequest {
  id                String            @id @default(uuid())
  requestNumber     String            @unique
  userId            Int
  sellerUserId      Int
  amount            Int
  currency          String            @default("DIAMOND")
