// ═══════════════════════════════════════════════════════════════════════════════
// ████ AVATAR FRAME SYSTEM — Complete Cosmetic Frame Management ████
// ═══════════════════════════════════════════════════════════════════════════════

model AvatarFrame {
  id                  String    @id @default(uuid())
  name                String
  description         String?
  slug                String    @unique
  assetUrl            String    // PNG/WebP/SVG URL for the frame overlay
  thumbnailUrl        String?   // Small preview thumbnail
  previewUrl          String?   // Full-size preview
  animationType       String    @default("static") // static, lottie, svga
  category            String    @default("CLASSIC") // CLASSIC, VIP, PREMIUM, LUXURY, EVENT, FESTIVAL, FAMILY, ACHIEVEMENT, LEVEL, LIMITED_EDITION, SEASONAL, COUNTRY, SPECIAL
  price               Int       @default(0)         // Diamond price
  currency            String    @default("DIAMOND") // DIAMOND or COIN
  durationDays        Int?      // null = permanent
  isPermanent         Boolean   @default(false)
  requiredVipLevel    Int       @default(0)    // Minimum VIP tier to purchase
  requiredUserLevel   Int       @default(0)    // Minimum user level to purchase
  countryAvailability String?   // JSON array of country codes, null = worldwide
  rarity              String    @default("COMMON") // COMMON, RARE, EPIC, LEGENDARY, MYTHIC
  status              String    @default("DRAFT")  // DRAFT, ACTIVE, INACTIVE, ARCHIVED
  isFeatured          Boolean   @default(false)
  sortOrder           Int       @default(0)
  startAt             DateTime? // Time-limited availability start
  endAt               DateTime? // Time-limited availability end
  salesCount          Int       @default(0)
  ownersCount         Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ownerships          AvatarFrameOwnership[]
  purchases           AvatarFramePurchase[]
  grants              AvatarFrameGrant[]

  @@index([category])
  @@index([status])
  @@index([rarity])
  @@index([isFeatured])
  @@index([sortOrder])
}

model AvatarFrameOwnership {
  id            String    @id @default(uuid())
  userId        Int
  frameId       String
  source        String    @default("PURCHASE") // PURCHASE, VIP_REWARD, LEVEL_REWARD, EVENT_REWARD, ADMIN_GRANT, FAMILY_REWARD
  status        String    @default("ACTIVE")   // ACTIVE, EXPIRED, REVOKED
  isEquipped    Boolean   @default(false)
  acquiredAt    DateTime  @default(now())
  expiresAt     DateTime? // null = permanent
  revokedAt     DateTime?
  revokedReason String?

  user          User          @relation("UserFrameOwnerships", fields: [userId], references: [id], onDelete: Cascade)
  frame         AvatarFrame   @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@unique([userId, frameId, source])
  @@index([userId])
  @@index([frameId])
  @@index([status])
  @@index([expiresAt])
}

model AvatarFramePurchase {
  id              String    @id @default(uuid())
  userId          Int
  frameId         String
  amount          Int       // Diamond/Coin amount paid
  currency        String    @default("DIAMOND")
  idempotencyKey  String    @unique
  status          String    @default("COMPLETED") // COMPLETED, FAILED, REFUNDED
  createdAt       DateTime  @default(now())

  user            User          @relation("UserFramePurchases", fields: [userId], references: [id], onDelete: Cascade)
  frame           AvatarFrame   @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([frameId])
}

model AvatarFrameGrant {
  id            String    @id @default(uuid())
  adminId       Int       // Admin who granted
  userId        Int       // User who received
  frameId       String
  durationDays  Int?      // null = permanent
  reason        String?
  createdAt     DateTime  @default(now())

  frame         AvatarFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([frameId])
}

