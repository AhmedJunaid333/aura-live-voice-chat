  user      User     @relation("UserMomentComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId])
  @@index([userId])
  @@index([createdAt])
}

model MomentShare {
  id        String   @id @default(uuid())
  momentId  String
  userId    Int
  platform  String   @default("INTERNAL") // INTERNAL, CHAT, WHATSAPP, COPY_LINK
  createdAt DateTime @default(now())

  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation("UserMomentShares", fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId])
  @@index([userId])
}

model MomentView {
  id        String   @id @default(uuid())
  momentId  String
  userId    Int?
