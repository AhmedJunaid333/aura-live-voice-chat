datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int               @id @default(autoincrement())
  numericId       Int               @unique
  username        String            @unique
  displayName     String?
  email           String?           @unique
  phone           String?           @unique
  passwordHash    String
  avatar          String?
  cover           String?
  bio             String?           @default("Aura Live Registered User ✨")
  gender          String?           @default("Prefer not to say")
  birthday        DateTime?
  country         String?           @default("Pakistan")
  countryCode     String?           @default("PK")
  level           Int               @default(1)
  xp              Int               @default(0)
  vipTier         Int               @default(0)
  coins           Int               @default(0)
  diamonds        Int               @default(0)
  role            String            @default("USER")
  status          String            @default("ACTIVE")
  walletFrozen    Boolean           @default(false)
  cnicNumber      String?
  cnicFrontUrl    String?
  selfieUrl       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships
  sessions              Session[]
  walletTransactions    WalletTransaction[]
  resellerAccount       ResellerAccount?
  sentInvitations       ResellerInvitation[]    @relation("InviterAdmin")
  receivedInvitations   ResellerInvitation[]    @relation("TargetUser")
  applications          ResellerApplication[]   @relation("ApplicantUser")
  reviewedApplications  ResellerApplication[]   @relation("ReviewerAdmin")
  hostedRooms           LiveRoom[]              @relation("HostUser")
  sentMessages          Message[]               @relation("MessageSender")
  conversationMembers   ConversationMember[]
  sentGifts             GiftTransaction[]       @relation("GiftSender")
  receivedGifts         GiftTransaction[]       @relation("GiftReceiver")
  medals                UserMedal[]
  familyMembership      FamilyMember?
  blockedUsers          BlockedUser[]           @relation("UserBlocker")
  blockedBy             BlockedUser[]           @relation("UserBlocked")
  auditLogs             AuditLog[]              @relation("ActorUser")
  authAccounts          AuthAccount[]
  coinSellerAccount     CoinSellerAccount?
  withdrawalRequests    WithdrawalRequest[]     @relation("UserWithdrawals")
  following             Follow[]                @relation("UserFollowers")
  followers             Follow[]                @relation("UserFollowing")
  visitsMade            ProfileVisit[]          @relation("UserVisitsMade")
  visitsReceived        ProfileVisit[]          @relation("UserVisitsReceived")
  notifications         Notification[]          @relation("NotificationRecipient")
  sentNotifications     Notification[]          @relation("NotificationSender")
  reportsFiled          MessageReport[]         @relation("ReportedBy")
  reportsReceived       MessageReport[]         @relation("ReportedTarget")
  roomJoinRequests      RoomJoinRequest[]       @relation("UserJoinRequests")
  ledFamilies           Family[]                @relation("FamilyLeader")
  sentFamilyInvitations FamilyInvitation[]      @relation("SentFamilyInvitations")
  receivedFamilyInvitations FamilyInvitation[]  @relation("ReceivedFamilyInvitations")
  familyBans            FamilyBan[]             @relation("FamilyBannedUser")
  executedFamilyBans    FamilyBan[]             @relation("FamilyBanActor")
  familyMessages        FamilyMessage[]         @relation("FamilyMessages")
  familyAnnouncements   FamilyAnnouncement[]    @relation("FamilyAnnouncements")
  familyContributions   FamilyContribution[]    @relation("UserFamilyContributions")
  mutedUsers            MutedUser[]             @relation("UserMuter")
  mutedBy               MutedUser[]             @relation("UserMuted")
  userReportsFiled      UserReport[]            @relation("UserReportedBy")
  userReportsReceived   UserReport[]            @relation("UserReportedTarget")

  @@index([numericId])
  @@index([username])
}

model AuthAccount {
  id                String   @id @default(uuid())
  userId            Int
  provider          String   @default("GOOGLE")
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id            String    @id @default(uuid())
  userId        Int
  token         String    @unique
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id            String        @id @default(uuid())
  userId        Int
  type          String
  currency      String
  amount        Int
  balanceAfter  Int           @default(0)
  referenceId   String?
  notes         String?
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResellerAccount {
  id                String            @id @default(uuid())
  userId            Int               @unique
  role              String            @default("DIAMOND_RESELLER")
  status            String            @default("ACTIVE")
  diamondBalance    Int               @default(0)
  diamondsReceived  Int               @default(0)
  diamondsSent      Int               @default(0)
  assignedAt        DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model ResellerInvitation {
  id                String            @id @default(uuid())
  code              String            @unique
  type              String            @default("RESELLER")
  targetUserId      Int
  invitedByAdminId  Int
  message           String?
  requirements      String?
  benefits          String?
  expiryDays        Int               @default(7)
  expiresAt         DateTime
  status            String            @default("PENDING")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  targetUser        User              @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  invitedByAdmin    User              @relation("InviterAdmin", fields: [invitedByAdminId], references: [id], onDelete: Cascade)
  application       ResellerApplication?
}

model ResellerApplication {
  id                String              @id @default(uuid())
  invitationId      String?             @unique
  userId            Int
  type              String              @default("RESELLER")
  applicantName     String
  email             String?
  phone             String?
  country           String?
  city              String?
  formData          String?
  documents         String?
  status            String              @default("SUBMITTED")
  reviewerAdminId   Int?
  notes             String?
  submittedAt       DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user              User                @relation("ApplicantUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewerAdmin     User?               @relation("ReviewerAdmin", fields: [reviewerAdminId], references: [id], onDelete: SetNull)
  invitation        ResellerInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
}

model ResellerLedger {
  id            String        @id @default(uuid())
  senderId      String
  senderRole    String
  receiverId    String
  receiverRole  String
  amount        Int
  currency      String        @default("DIAMOND")
  type          String
  status        String        @default("COMPLETED")
  referenceId   String?
  createdAt     DateTime      @default(now())
}


model Conversation {
  id            String                @id @default(uuid())
  isGroup       Boolean               @default(false)
  title         String?
  lastMessageAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  members       ConversationMember[]
  messages      Message[]
}

model ConversationMember {
  id              String        @id @default(uuid())
  conversationId  String
  userId          Int
  joinedAt        DateTime      @default(now())
  lastReadAt      DateTime      @default(now())

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id              String        @id @default(uuid())
  conversationId  String
  senderId        Int
  type            String        @default("TEXT")
  content         String
  mediaUrl        String?
  metadata        String?
  isRead          Boolean       @default(false)
  readAt          DateTime?
  isDeleted       Boolean       @default(false)
  replyToId       String?
  createdAt       DateTime      @default(now())

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reports         MessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model LiveRoom {
  id                String            @id @default(uuid())
  roomId            String            @unique
  title             String
  category          String            @default("Music")
  hostId            Int
  seatCount         Int               @default(10)
  status            String            @default("LIVE") // LIVE, LOCKED, ENDED
  isLocked          Boolean           @default(false)
  lockedAt          DateTime?
  lockedBy          Int?
  lockMode          String?           @default("MANUAL_LOCK") // MANUAL_LOCK, PASSWORD_LOCK
  lockPassword      String?
  allowsJoinRequest Boolean           @default(true)
  listenersCount    Int               @default(0)
  isPK              Boolean           @default(false)
  theme             String            @default("galaxy")
  familyId          String?
  isFamilyOnly      Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  host              User              @relation("HostUser", fields: [hostId], references: [id], onDelete: Cascade)
  family            Family?           @relation(fields: [familyId], references: [id], onDelete: SetNull)
  giftTxns          GiftTransaction[]
  joinRequests      RoomJoinRequest[]
}

model RoomJoinRequest {
  id              String          @id @default(uuid())
  roomId          String
  userId          Int
  userName        String
  userAvatar      String?
  status          String          @default("PENDING") // PENDING, ACCEPTED, REJECTED
  reviewedBy      Int?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  room            LiveRoom        @relation(fields: [roomId], references: [roomId], onDelete: Cascade)
  user            User            @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, status])
  @@index([userId])
}

model Gift {
  id              String          @id @default(uuid())
  name            String
  icon            String
  costCoins       Int
  rewardDiamonds  Int
  category        String          @default("Popular")
  animationType   String          @default("SVG")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())

  transactions    GiftTransaction[]
}

model GiftTransaction {
  id              String        @id @default(uuid())
  roomId          String?
  senderId        Int
  receiverId      Int
  giftId          String
  count           Int           @default(1)
  totalCoins      Int
  totalDiamonds   Int
  createdAt       DateTime      @default(now())

  room            LiveRoom?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sender          User          @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User          @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  gift            Gift          @relation(fields: [giftId], references: [id], onDelete: Cascade)
}

model Family {
  id              String                @id @default(uuid())
  familyId        String                @unique
  name            String                @unique
  icon            String?               @default("🦁")
  logo            String?
  description     String?               @default("Official Aura Live Family")
  rules           String?               @default("1. Respect all members\n2. Support family audio rooms\n3. Follow Aura Live guidelines")
  leaderId        Int
  level           Int                   @default(1)
  xp              Int                   @default(0)
  totalDiamonds   Int                   @default(0)
  weeklyDiamonds  Int                   @default(0)
  monthlyDiamonds Int                   @default(0)
  treasuryCoins   Int                   @default(0)
  status          String                @default("ACTIVE") // ACTIVE, SUSPENDED
  badge           String?               @default("👑 VIP FAMILY")
  country         String                @default("Pakistan")
  notice          String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  leader          User                  @relation("FamilyLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members         FamilyMember[]
  invitations     FamilyInvitation[]
  rooms           LiveRoom[]
  messages        FamilyMessage[]
  announcements   FamilyAnnouncement[]
  contributions   FamilyContribution[]
  bans            FamilyBan[]
}

model FamilyMember {
  id                    String      @id @default(uuid())
  familyId              String
  userId                Int         @unique
  role                  String      @default("MEMBER") // OWNER, ADMIN, CO_ADMIN, HOST, MEMBER
  contributionDiamonds  Int         @default(0)
  contributionCoins     Int         @default(0)
  permissions           String?
  joinedAt              DateTime    @default(now())

  family                Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, role])
}

model FamilyInvitation {
  id            String      @id @default(uuid())
  familyId      String
  inviterId     Int
  targetUserId  Int
  status        String      @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?

  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviter       User        @relation("SentFamilyInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  targetUser    User        @relation("ReceivedFamilyInvitations", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, status])
  @@index([familyId, status])
}

model FamilyBan {
  id          String      @id @default(uuid())
  familyId    String
  userId      Int
  bannedBy    Int
  reason      String?
  createdAt   DateTime    @default(now())

  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User        @relation("FamilyBannedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor       User        @relation("FamilyBanActor", fields: [bannedBy], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

model FamilyMessage {
  id          String      @id @default(uuid())
  familyId    String
  senderId    Int
  type        String      @default("TEXT") // TEXT, IMAGE, GIFT_ALERT, SYS_JOIN, SYS_ROLE
  content     String
  mediaUrl    String?
  replyToId   String?
  createdAt   DateTime    @default(now())

  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sender      User        @relation("FamilyMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

model FamilyAnnouncement {
  id          String      @id @default(uuid())
  familyId    String
  authorId    Int
  title       String
  content     String
  isPinned    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author      User        @relation("FamilyAnnouncements", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([familyId, isPinned])
}

model FamilyContribution {
  id                String      @id @default(uuid())
  familyId          String
  userId            Int
  diamonds          Int         @default(0)
  coins             Int         @default(0)
  giftTransactionId String?
  createdAt         DateTime    @default(now())

  family            Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user              User        @relation("UserFamilyContributions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
  @@index([userId])
}

model Medal {
  id                String      @id @default(uuid())
  name              String
  category          String
  icon              String
  rarity            String      @default("RARE")
  xpBonus           String?
  unlockCondition   String?
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())

  userMedals        UserMedal[]
}

model UserMedal {
  id            String    @id @default(uuid())
  userId        Int
  medalId       String
  awardedAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal         Medal     @relation(fields: [medalId], references: [id], onDelete: Cascade)

  @@unique([userId, medalId])
}

model BlockedUser {
  id            String    @id @default(uuid())
  blockerId     Int
  blockedId     Int
  reason        String?
  createdAt     DateTime  @default(now())

  blocker       User      @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked       User      @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model AuditLog {
  id            String    @id @default(uuid())
  actorId       Int?
  actorRole     String
  action        String
  resource      String
  details       String?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  actor         User?     @relation("ActorUser", fields: [actorId], references: [id], onDelete: SetNull)
}

model CoinSellerAccount {
  id                String              @id @default(uuid())
  userId            Int                 @unique
  sellerName        String
  status            String              @default("ACTIVE")
  paymentMethods    String              @default("Easypaisa,JazzCash,Bank Transfer,USDT")
  totalProcessed    Int                 @default(0)
  assignedAt        DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[] @relation("SellerWithdrawals")
}

model WithdrawalRequest {
  id                String            @id @default(uuid())
  requestNumber     String            @unique
  userId            Int
  sellerUserId      Int
  amount            Int
  currency          String            @default("DIAMOND")
  payoutAmount      Float             @default(0.0)
  paymentMethod     String
  accountTitle      String
  accountNumber     String
  status            String            @default("PENDING")
  transactionId     String            @unique
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation("UserWithdrawals", fields: [userId], references: [id], onDelete: Cascade)
  sellerUser        CoinSellerAccount @relation("SellerWithdrawals", fields: [sellerUserId], references: [userId], onDelete: Cascade)
}

model RechargePackage {
  id            String    @id @default(uuid())
  coins         Int
  coinsLabel    String
  price         String
  priceUsd      Float     @default(0.0)
  bonus         String    @default("")
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Follow {
  id          String   @id @default(uuid())
  followerId  Int
  followingId Int
  status      String   @default("ACCEPTED")
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ProfileVisit {
  id             String   @id @default(uuid())
  visitorId      Int
  profileOwnerId Int
  visitedAt      DateTime @default(now())

  visitor      User @relation("UserVisitsMade", fields: [visitorId], references: [id], onDelete: Cascade)
  profileOwner User @relation("UserVisitsReceived", fields: [profileOwnerId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([profileOwnerId])
  @@index([profileOwnerId, visitedAt])
}

model Notification {
  id          String    @id @default(uuid())
  recipientId Int
  senderId    Int
  type        String    @default("FOLLOW")
  entityId    String?
  title       String
  message     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, readAt])
}

model VipTierConfig {
  id            String   @id @default(uuid())
  level         Int      @unique
  tierName      String
  shortBadge    String
  colorHex      String   @default("#CD7F32")
  expRequired   Int
  priceUsd      Float    @default(10.0)
  perksJson     String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StoreItem {
  id            String   @id @default(uuid())
  name          String
  category      String
  priceCoins    Int      @default(0)
  priceDiamonds Int      @default(0)
  durationDays  Int      @default(30)
  description   String
  icon          String   @default("car")
  colorHex      String   @default("#00E5FF")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MessageReport {
  id              String   @id @default(uuid())
  reporterId      Int
  reportedUserId  Int
  messageId       String?
  reason          String
  status          String   @default("PENDING")
  resolutionNote  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reporter        User     @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User     @relation("ReportedTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)
  message         Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

model MutedUser {
  id            String    @id @default(uuid())
  muterId       Int
  mutedId       Int
  reason        String?
  createdAt     DateTime  @default(now())

  muter         User      @relation("UserMuter", fields: [muterId], references: [id], onDelete: Cascade)
  muted         User      @relation("UserMuted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

model UserReport {
  id              String   @id @default(uuid())
  reporterId      Int
  reportedUserId  Int
  category        String   @default("GENERAL")
  reason          String
  details         String?
  status          String   @default("PENDING")
  resolutionNote  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reporter        User     @relation("UserReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User     @relation("UserReportedTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
}

