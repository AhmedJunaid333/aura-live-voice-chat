model MembershipHistory {
  id                  String   @id @default(uuid())
  userId              Int
  membershipType      String   // VIP, SVIP
  previousLevel       Int
  newLevel            Int
  xpAtTransition      Int      @default(0)
  eventType           String   // UPGRADE, DOWNGRADE, RENEWAL, EXPIRY, ADMIN_OVERRIDE, REWARD_CLAIM
  rewardGrantedJson   String?
  reason              String?
  adminId             Int?
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([membershipType])
  @@index([eventType])
  @@index([createdAt])
}

model MembershipRewardClaim {
  id                  String   @id @default(uuid())
  idempotencyKey      String   @unique // e.g. "USER_1_VIP_3_LEVEL_UP" or "USER_1_VIP_3_DAILY_2026-08-15"
  userId              Int
  membershipType      String   // VIP, SVIP
  level               Int
  rewardType          String   // LEVEL_UP, DAILY, WEEKLY, MONTHLY
  periodKey           String?  // e.g. "2026-08-15" for daily, "2026-W33" for weekly, "2026-08" for monthly
  diamondsAwarded     Int      @default(0)
  coinsAwarded        Int      @default(0)
  xpAwarded           Int      @default(0)
  itemsAwardedJson    String?
  claimedAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([membershipType, level])
  @@index([rewardType])
