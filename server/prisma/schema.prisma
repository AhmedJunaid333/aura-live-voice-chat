model MembershipEvent {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  eventType           String   // DOUBLE_XP, RECHARGE_BONUS, VIP_UPGRADE, SEASONAL
  multiplier          Float    @default(2.0)
  bonusXp             Int      @default(0)
  bonusRewardJson     String?
  eligibleVipMin      Int      @default(0)
  eligibleSvipMin     Int      @default(0)
  startsAt            DateTime
  endsAt              DateTime
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([active])
  @@index([startsAt, endsAt])
}

model MembershipAuditLog {
  id                  String   @id @default(uuid())
  adminId             Int
  targetUserId        Int
  action              String   // GRANT_VIP, REVOKE_VIP, GRANT_SVIP, REVOKE_SVIP, ADJUST_XP, OVERRIDE_EXPIRY
  previousStateJson   String?
  newStateJson        String?
  reason              String   // Mandatory explanation for audit compliance
  ipAddress           String?
  createdAt           DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════════════════
// 📋 AURA LIVE APPLICATIONS ENGINE (AGENCY & HOSTING)
// ════════════════════════════════════════════════════════════════════════════

model Application {
  id                String    @id @default(uuid())
  applicationId     String    @unique // e.g. "APP-AGY-100001-XXXX" or "APP-HST-100001-XXXX"
  userId            Int
  type              String    // AGENCY, HOSTING
  status            String    @default("PENDING") // DRAFT, PENDING, UNDER_REVIEW, APPROVED, REJECTED, CANCELLED
  
  // Personal Info
  fullName          String
  username          String
  phone             String
  email             String?
  country           String    @default("Pakistan")
  city              String

  // Agency Specific
  agencyName        String?
  agencyDescription String?
  expectedHosts     Int?
  
  // Hosting Specific
  category          String?   // Singing, Gaming, Chatting, Dance, Talent, etc.
  dailyHours        Float?
  schedule          String?
  
  // Shared Details
  experience        String?
  whyJoin           String
  socialLinks       String?
  documentsJson     String?   @default("[]")
  additionalInfo    String?
  
  // Admin Review & Status Notes
  adminNotes        String?
  rejectionReason   String?
  reviewedBy        Int?
  reviewedAt        DateTime?
  
  submittedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation("UserProfileApplications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([submittedAt])
}


