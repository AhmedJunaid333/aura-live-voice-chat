model Moment {
  id                String          @id @default(uuid())
  numericId         Int             @unique
  authorId          Int
  mediaUrl          String
  mediaType         String          @default("IMAGE") // IMAGE, VIDEO, TEXT
  thumbnailUrl      String?
  caption           String?
  hashtags          String?         // JSON array or comma separated
  mentions          String?         // JSON array
  privacy           String          @default("PUBLIC") // PUBLIC, FOLLOWERS, PRIVATE
  countryCode       String          @default("PK")
  status            String          @default("PUBLISHED") // PUBLISHED, RESTRICTED, DELETED, PENDING_REVIEW
  moderationStatus  String          @default("APPROVED") // APPROVED, FLAGGED, REJECTED, PENDING
  featured          Boolean         @default(false)
  featuredAt        DateTime?
  rankingScore      Float           @default(0.0)
  viewCount         Int             @default(0)
  likeCount         Int             @default(0)
  commentCount      Int             @default(0)
  shareCount        Int             @default(0)
  reportsCount      Int             @default(0)
  assignedModerator String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  expiresAt         DateTime?

  author            User            @relation("UserMoments", fields: [authorId], references: [id], onDelete: Cascade)
  likes             MomentLike[]
  comments          MomentComment[]
  shares            MomentShare[]
  views             MomentView[]
  reports           MomentReport[]

  @@index([authorId])
  @@index([status])
  @@index([featured])
  @@index([countryCode])
  @@index([rankingScore])
  @@index([createdAt])
}

model MomentLike {
  id        String   @id @default(uuid())
  momentId  String
  userId    Int
  createdAt DateTime @default(now())

  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation("UserMomentLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, momentId])
  @@index([momentId])
  @@index([userId])
}

model MomentComment {
