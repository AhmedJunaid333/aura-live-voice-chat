  createdAt DateTime @default(now())

  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@index([momentId])
  @@index([userId])
}

model MomentReport {
  id          String   @id @default(uuid())
  momentId    String
  reporterId  Int
  reason      String
  details     String?
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())

  moment      Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
