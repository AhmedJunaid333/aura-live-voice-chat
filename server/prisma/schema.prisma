model MembershipProfile {
  id                  String    @id @default(uuid())
  userId              Int       @unique
  vipLevel            Int       @default(0) // 0 means no VIP, 1-7
  svipLevel           Int       @default(0) // 0 means no SVIP, 1-15
  vipXp               Int       @default(0)
  svipXp              Int       @default(0)
  lifetimeRechargeUsd Float     @default(0.0)
  vipStatus           String    @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED, SUSPENDED, CANCELLED
  svipStatus          String    @default("INACTIVE") // INACTIVE, ACTIVE, EXPIRING_SOON, EXPIRED, SUSPENDED
  vipStartedAt        DateTime?
  vipExpiresAt        DateTime?
  svipStartedAt       DateTime?
  svipExpiresAt       DateTime?
  lastRenewalAt       DateTime?
  autoRenew           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vipLevel])
  @@index([svipLevel])
  @@index([vipStatus])
  @@index([svipStatus])
}

model MembershipXpTransaction {
  id                  String   @id @default(uuid())
  transactionId       String   @unique @default(uuid())
  userId              Int
  membershipType      String   @default("VIP") // VIP, SVIP
  source              String   // RECHARGE, PURCHASE, ACTIVITY, ADMIN_GRANT, EVENT, CAMPAIGN
  amount              Float    @default(0)
  xpAwarded           Int
  referenceId         String?
  status              String   @default("CONFIRMED") // CONFIRMED, PENDING, REVERSED
