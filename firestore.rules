rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aura Live Voice Room Collections
    match /users/{userId} {
      allow read, write: if true;
    }
    match /rooms/{roomId} {
      allow read, write: if true;
      match /chats/{chatId} {
        allow read, write: if true;
      }
      match /seats/{seatId} {
        allow read, write: if true;
      }
    }
    match /wallets/{walletId} {
      allow read, write: if true;
    }
    match /gifts/{giftId} {
      allow read, write: if true;
    }
    match /agencies/{agencyId} {
      allow read, write: if true;
    }
  }
}
